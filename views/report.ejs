<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin: 0;
            padding: 20px;
            background-color: #f4f4f4;
        }

        h1 {
            color: #333;
            margin-bottom: 20px;
        }

        ul {
            list-style-type: none;
            padding: 20px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            
            /* Flexbox to align items horizontally */
            display: flex;
            justify-content: center; /* Centers the group of items */
            gap: 20px; /* Adds space between each student card */
            flex-wrap: wrap; /* Allows items to wrap to the next line on small screens */
        }

        li {
            /* Removed margin-bottom as it's no longer needed for vertical spacing */
            border: 1px solid #eee;
            padding: 15px;
            border-radius: 6px;
            background-color: #fafafa;
            min-width: 200px; /* Ensures cards don't get too squished */
            text-align: left;
        }

        p {
            margin: 5px 0;
            color: #555;
        }
    </style>
</head>
<body>
    <%- include('header')%>
    <h1>Student Report</h1>
   
    <ul>
        <% students.map((student)=>{ %>
            <li>
                <p><strong>Name:</strong> <%= student.name %></p>
                <p><strong>Grade:</strong> <%= student.grade %></p>
                <p><strong>Fav Subject:</strong> <%= student.favoriteSubject %></p>
            </li>
        <% }) %> 
    </ul>
    
</body>
</html>   